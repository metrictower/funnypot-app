{
    "name": "metrictower/funnypot-app",
    "description": "funnypot-app: a standalone multi-protocol honeypot. HTTP nuclei-inversion deception (via funnypot-core) plus SSH, telnet, redis, mysql and 14 more TCP service emulators, with a live attacker dashboard.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "0": {
            "type": "vcs",
            "url": "https://github.com/metrictower/funnypot-core"
        }
    },
    "require": {
        "php": ">=8.0",
        "ext-sodium": "*",
        "ext-openssl": "*",
        "metrictower/funnypot-core": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "symfony/yaml": "^5.4 || ^6.0"
    },
    "autoload": {
        "psr-4": {
            "Funnypot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Funnypot\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
