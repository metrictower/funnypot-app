# Copy this to scripts/deploy.env (which is gitignored) and fill in your server.
# Keeps your host + key out of the public repo.
FUNNYPOT_HOST=your-server.example.com
FUNNYPOT_USER=ec2-user
FUNNYPOT_KEY=/path/to/your-key.pem
# Optional — where the code lives on the server:
# FUNNYPOT_REMOTE_DIR=/home/ec2-user/funnypot

# Optional — interactive style (default realistic). taunt = stream the troll animation on every
# SSH/telnet login and append the trollface to the HTTP decoys; realistic = believable,
# cover-preserving fakes with no troll. Only set taunt on a box you are happy to reveal.
# FUNNYPOT_STYLE=taunt

# Optional — a deploy-managed install master (docs/IDENTITY.md). A path ON THE SERVER to a root-owned
# 0600 file holding the canonical one-line master; bind-mounted read-only into the preflight and the
# public container. Leave unset and the app creates + persists its own master on the data volume.
# Changing or removing it later is NOT recovery — it is the offline rotation procedure.
# FUNNYPOT_INSTALL_SECRET_FILE=/etc/funnypot/install.secret
# FUNNYPOT_PERSONA_SEED is NOT a deploy knob and scripts/deploy.sh does not forward it: the visible
# persona is derived from the install master, so every install already has its own. The cosmetic
# override exists only as a container identity input (demo/docker-compose.yml, docs/IDENTITY.md).

# Optional — real HTTPS via Let's Encrypt for one hostname (scripts/letsencrypt.sh).
# The DNS A record for LE_DOMAIN must already point at FUNNYPOT_HOST, and the security
# group must allow inbound port 80 (HTTP-01 challenge) and 443.
LE_DOMAIN=admin.example.com
LE_EMAIL=you@example.com

# Optional — password for the dashboard admin actions (Emulations toggle panel, prune, clear,
# geoip). Unset ⇒ the dashboard view stays public but every mutating/admin action is disabled.
# It is passed straight into the container by scripts/deploy.sh.
# FUNNYPOT_ADMIN_PASSWORD=change-me

# Optional — report the attacker IPs the honeypot catches to our own Threat Intel service
# (funnypot-mainnet, POST /v1/report), so the network collects real threats. Off unless
# FUNNYPOT_THREATINTEL_REPORT=on AND a sensor-tier key is set. The URL is scheme+host only (the
# reporter appends /v1/report). Reporting self-excludes FUNNYPOT_SELF_IPS, so set that first.
# FUNNYPOT_THREATINTEL_REPORT=on
# FUNNYPOT_THREATINTEL_URL=https://threatintel.metrictower.com
# FUNNYPOT_THREATINTEL_KEY=mnk_your_sensor_key

# Optional — after moving the host sshd off 22 (scripts/move-sshd-port.sh) so the honeypot can
# take port 22: set the moved sshd port (deploy connects on it) and turn on the host-22 -> ssh
# honeypot mapping. Do NOT set FUNNYPOT_SSH_ON_22 until sshd has actually vacated 22 (finalize).
# FUNNYPOT_SSH_PORT=62222
# FUNNYPOT_SSH_ON_22=1

# LLM-generated fake responses for plausible unknown paths, via the funnypot-llm sidecar (a separate
# repo; FUNNYPOT_LLM_REPO points at its checkout, default ../funnypot-llm). The sidecar bakes in a
# small CPU model, so it is memory/CPU-heavy: on a small box keep the caps low. funnypot always
# degrades to a plain 404 when it is slow or down, so it never risks the honeypot.
# ON BY DEFAULT now — scripts/deploy.sh bakes in the values below, so a bare deploy ships the sidecar.
# Set FUNNYPOT_LLM_ON=0 to skip it; uncomment any line below only to OVERRIDE a baked-in default.
# FUNNYPOT_LLM_ON=0                # set to 0 to disable the sidecar (default is 1 / on)
# FUNNYPOT_LLM_REPO=/path/to/funnypot-llm
# FUNNYPOT_LLM_MEM=1500m           # hard RAM cap on the sidecar (OOM-kills the sidecar, never funnypot)
# FUNNYPOT_LLM_MEM_SWAP=1800m      # RAM + swap ceiling for the sidecar
# FUNNYPOT_LLM_THREADS=2           # model CPU threads (leave a core for the honeypot on a 2-vCPU box)
# FUNNYPOT_LLM_PARALLEL=2          # llama.cpp decode slots
# FUNNYPOT_LLM_MAX_CONCURRENT=1    # most generations funnypot runs at once; the rest fall to plain 404
# FUNNYPOT_LLM_TIMEOUT_MS=13000    # a generation slower than this becomes a plain 404
# FUNNYPOT_LLM_VELOCITY_PER_60S=30 # per-IP LLM calls/60s before shedding to 404 (default 30)
# FUNNYPOT_LLM_VELOCITY_PER_10M=100 # per-IP LLM calls/10min before shedding to 404 (default 100)
