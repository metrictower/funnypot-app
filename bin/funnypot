#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * funnypot app CLI. Build-time helpers for the standalone honeypot:
 *
 *   funnypot compile-protocols [<dir>] [--out=PATH]   compile templates/protocol -> funnypot-protocols.php
 *   funnypot compile-catalog [--out=PATH]             derive the emulation catalog (app + engine templates)
 *   funnypot vulns:sync [--out=funnypot-vulns.json]   materialise the on/off toggle list
 *   funnypot vulns:list [--file=funnypot-vulns.json]
 *
 * The HTTP engine (nuclei inversion, attack/route emulators) lives in metrictower/funnypot-core and
 * has its own `compile` commands; this CLI only owns the app-side artifacts. Needs `composer install`.
 */

use Funnypot\App\Build\CatalogCompiler;
use Funnypot\App\Build\ProtocolCompiler;
use Funnypot\App\Emulation\EmulationCatalog;
use Funnypot\App\Emulation\EmulationPolicy;

$root = dirname(__DIR__);
$autoload = $root . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Missing vendor/autoload.php, run `composer install`.\n");
    exit(2);
}
require $autoload;

$argvv = $argv;
array_shift($argvv);
$command = array_shift($argvv) ?? '';
$optOut = static function (array $argvv, string $default): string {
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--out=', 6) === 0 || strncmp($arg, '--file=', 7) === 0) {
            return substr($arg, strpos($arg, '=') + 1);
        }
    }

    return $default;
};

if ($command === 'compile-protocols') {
    $dir = $root . '/templates/protocol';
    $out = $optOut($argvv, $root . '/resources/compiled/funnypot-protocols.php');
    foreach ($argvv as $arg) {
        if (strncmp($arg, '--', 2) !== 0) {
            $dir = $arg;
        }
    }
    $protocols = (new ProtocolCompiler())->compile($dir);
    $php = "<?php\n\ndeclare(strict_types=1);\n\n// GENERATED by `funnypot compile-protocols` — DO NOT EDIT.\n\nreturn "
        . var_export($protocols, true) . ";\n";
    file_put_contents($out, $php);
    fwrite(STDOUT, count($protocols) . " protocols compiled -> {$out}\n");
    exit(0);
}

if ($command === 'compile-catalog') {
    // The catalog spans the engine's attack/route templates (from vendor) and the app's protocol
    // templates + nuclei corpus count.
    $engineRoot = $root . '/vendor/metrictower/funnypot-core';
    if (!is_dir($engineRoot . '/templates/attack')) {
        $engineRoot = $root; // mono-repo / local fallback
    }
    $out = $optOut($argvv, $root . '/resources/compiled/funnypot-catalog.php');
    $catalog = (new CatalogCompiler())->compile($root, $engineRoot);
    $php = "<?php\n\ndeclare(strict_types=1);\n\n// GENERATED by `funnypot compile-catalog` — DO NOT EDIT.\n\nreturn "
        . var_export($catalog, true) . ";\n";
    file_put_contents($out, $php);
    fwrite(STDOUT, count($catalog) . " catalog entries compiled -> {$out}\n");
    exit(0);
}

if ($command === 'vulns:sync' || $command === 'vulns:list') {
    $overlay = $optOut($argvv, getenv('FUNNYPOT_VULNS') ?: $root . '/demo/storage/funnypot-vulns.json');
    $catalog = EmulationCatalog::fromPackage();
    if ($catalog->count() === 0) {
        fwrite(STDERR, "error: no catalog, run `funnypot compile-catalog` first.\n");
        exit(2);
    }
    $policy = EmulationPolicy::fromCatalog($catalog, is_file($overlay) ? $overlay : null);

    if ($command === 'vulns:list') {
        foreach ($policy->resolved() as $id => $e) {
            fwrite(STDOUT, sprintf(
                "%s  %-8s  %-9s  %s\n",
                $e['enabled'] ? '[on ]' : '[off]',
                $e['kind'],
                $e['severity'],
                $id . ($e['cve'] !== '' ? "  ({$e['cve']})" : '')
            ));
        }
        exit(0);
    }

    $before = [];
    if (is_file($overlay)) {
        $raw = json_decode((string) file_get_contents($overlay), true);
        $before = is_array($raw) && isset($raw['vulns']) && is_array($raw['vulns']) ? $raw['vulns'] : [];
    }
    $vulns = $policy->materialize();
    $added = array_diff(array_keys($vulns), array_keys($before));
    $removed = array_diff(array_keys($before), array_keys($vulns));
    $payload = [
        'version' => 1,
        'updated' => gmdate('c'),
        'note' => 'Toggle which emulations funnypot serves. New capabilities auto-appear at their default on `funnypot vulns:sync`. true = serve, false = off.',
        'vulns' => $vulns,
    ];
    if (!is_dir(dirname($overlay))) {
        mkdir(dirname($overlay), 0777, true);
    }
    file_put_contents($overlay, json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
    fwrite(STDOUT, sprintf("synced %d entries (+%d new, -%d removed) -> %s\n", count($vulns), count($added), count($removed), $overlay));
    exit(0);
}

fwrite(STDERR, "usage: funnypot compile-protocols | compile-catalog | vulns:sync | vulns:list\n");
exit($command === '' || $command === 'help' || $command === '--help' ? 0 : 2);
