<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheResult="false">
    <testsuites>
        <testsuite name="funnypot">
            <directory>tests</directory>
        </testsuite>
        <!-- Everything except the seeded-panel render tests, which dominate wall time (each render
             rebuilds the full seeded Org roster + section corpus). Quick pre-deploy checks run this
             with: php vendor/bin/phpunit (space) (dash)(dash)testsuite fast -->
        <testsuite name="fast">
            <directory>tests</directory>
            <exclude>tests/App/Panel</exclude>
        </testsuite>
    </testsuites>
</phpunit>
